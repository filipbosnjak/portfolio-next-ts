GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Must match the redirect URI used when you obtained GOOGLE_REFRESH_TOKEN
# (OAuth Playground uses this by default):
# GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground

# Sending mailbox that owns the refresh token
# GMAIL_SENDER_EMAIL=test@gmail.com

# --- Visitor tracking dashboard ---
# Postgres connection (provisioned by the Neon integration on Vercel Marketplace)
DATABASE_URL=

# Google OAuth "Web application" client used only for the dashboard sign-in.
# Authorized redirect URI: <origin>/api/auth/google/callback
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Random secret for signing the admin session cookie (e.g. openssl rand -base64 32)
AUTH_SECRET=

# Secret URL segment of the dashboard, e.g. v-abc123xyz -> https://site/v-abc123xyz
# Letters, digits and dashes, at least 8 chars. Unset = dashboard disabled.
ADMIN_PATH=
